#!/usr/bin/env node
// cc-bridge: manage Claude ⇄ Codex pairings and inspect the transcript.
import {
  dataDir,
  pairLive,
  readTranscript,
  unpair,
} from '../lib/common.js'
import { install, doctor, uninstall } from '../lib/admin.js'
import { SCHEMA, configPath, initConfig, loadConfig, setConfig } from '../lib/config.js'
import { version } from '../lib/version.js'
import { messages, formatMessages } from '../lib/messages.js'
import { cancelPending } from '../lib/pending.js'
import { retryMessage } from '../lib/recovery.js'
import { listSessions, formatSessions } from '../lib/discovery.js'

const [cmd, ...rest] = process.argv.slice(2)
const flag = name => {
  const i = rest.indexOf(`--${name}`)
  return i === -1 ? undefined : rest[i + 1]
}

const usage = `usage:
  cc-bridge install
  cc-bridge uninstall [--purge]
  cc-bridge config [init | get <key> | set <key> <value>]
  cc-bridge doctor
  cc-bridge sessions
  cc-bridge pair --claude <label> --codex <thread-uuid>
  cc-bridge unpair --claude <label>
  cc-bridge status
  cc-bridge log [-n 20] [--verbose]
  cc-bridge retry <message-id>
  cc-bridge cancel <message-id>
  cc-bridge --help | --version`

const verbose = rest.includes('--verbose')
const allowed = {
  install: [], uninstall: ['--purge'], doctor: [], sessions: ['--verbose'], status: ['--verbose'],
  pair: ['--claude', '--codex'], unpair: ['--claude'], log: ['-n', '--verbose'],
}
if (rest.includes('--help') || ['help', '--help', '-h'].includes(cmd) || !cmd) { console.log(usage); process.exit(0) }
if (['--version', '-v'].includes(cmd)) { console.log(version); process.exit(0) }
function usageError(message) { console.error(`cc-bridge: ${message}\n${usage}`); process.exit(2) }
if (cmd in allowed) {
  for (let i = 0; i < rest.length; i++) {
    const arg = rest[i]
    if (!allowed[cmd].includes(arg)) usageError(`Unexpected argument: ${arg}`)
    if (['--claude', '--codex', '-n'].includes(arg)) {
      if (!rest[i + 1] || rest[i + 1].startsWith('-')) usageError(`Missing value for ${arg}`)
      i++
    }
  }
}
if (['retry', 'cancel'].includes(cmd) && (rest.length !== 1 || !/^[0-9a-f-]{36}$/.test(rest[0]))) usageError('Expected a message ID')
if (cmd === 'config' && !(!rest.length || (rest[0] === 'init' && rest.length === 1) || (rest[0] === 'get' && rest.length === 2) || (rest[0] === 'set' && rest.length === 3))) usageError('Invalid config arguments')
try {

switch (cmd) {
  case 'retry':
    console.log(await retryMessage(rest[0]))
    break
  case 'cancel':
    await cancelPending(rest[0]); console.log(`Cancelled request ${rest[0]}`)
    break
  case 'install':
    try { console.log(install()) } catch (e) { console.error(e.message); process.exitCode = 1 }
    break
  case 'uninstall': {
    const { done, skipped } = uninstall({ purge: rest.includes('--purge') })
    for (const d of done) console.log(d)
    for (const s of skipped) console.log(`skipped: ${s}`)
    console.log('Restart Codex and any running Claude sessions to finish.')
    break
  }
  case 'config': {
    const [sub, key, value] = rest
    try {
      if (sub === 'init') {
        console.log(initConfig() ? `wrote defaults to ${configPath()}` : `${configPath()} already exists; not changed`)
      } else if (sub === 'get' && key in SCHEMA) {
        console.log(JSON.stringify(loadConfig().values[key]))
      } else if (sub === 'set' && key && value !== undefined) {
        console.log(`${key} = ${JSON.stringify(setConfig(key, value))} in ${configPath()}`)
        if (key === 'plan_review.review_codex_plans') console.log('Run cc-bridge install to add or remove the Codex plan-review hook.')
        console.log('Running agents pick most changes up on their next action; restart them for claude_bin, data_dir or runtime_dir.')
      } else if (!sub) {
        const { file, exists, values, sources, warnings } = loadConfig()
        console.log(`config: ${file}${exists ? '' : ' (not created; run cc-bridge config init)'}`)
        for (const [k, spec] of Object.entries(SCHEMA)) {
          console.log(`  ${k} = ${JSON.stringify(values[k])}  [${sources[k]}]`)
          console.log(`      ${spec.doc}${spec.env ? `; env ${spec.env}` : ''}`)
        }
        for (const w of warnings) console.log(`warning: ${w}`)
      } else {
        console.error(usage)
        process.exitCode = 2
      }
    } catch (e) { console.error(e.message); process.exitCode = 1 }
    break
  }
  case 'doctor': {
    const checks = await doctor()
    for (const c of checks) console.log(`${c.ok ? 'OK' : 'FAIL'} ${c.name}${c.ok ? '' : ` — ${c.fix}`}`)
    console.log(formatSessions(await listSessions(), { verbose }))
    console.log('Channels activation is confirmed only by a live round trip; no model calls were made.')
    process.exitCode = checks.some(c => !c.ok) ? 1 : 0
    break
  }
  case 'sessions':
    console.log(formatSessions(await listSessions(), { verbose }))
    break
  case 'pair': {
    const label = flag('claude')
    const thread = flag('codex')
    if (!label || !thread) {
      console.error(usage)
      process.exit(2)
    }
    try {
      const { pair, replaced } = await pairLive(label, thread)
      console.log(`paired claude "${label}" (conversation ${pair.claude_session}) ⇄ codex ${thread}`)
      for (const r of replaced) console.log(`replaced: claude "${r.claude}" (conversation ${r.claude_session}) ⇄ codex ${r.codex}`)
    } catch (err) {
      console.error(`cc-bridge: ${err.message}`)
      process.exit(1)
    }
    break
  }
  case 'unpair': {
    const label = flag('claude')
    if (!label) {
      console.error(usage)
      process.exit(2)
    }
    console.log(await unpair(label) ? `unpaired "${label}"` : `"${label}" was not paired`)
    break
  }
  case 'status': {
    if (verbose) console.log(`data: ${dataDir()}`)
    console.log(formatSessions(await listSessions(), { verbose }))
    break
  }
  case 'log': {
    const index = rest.indexOf('-n')
    const n = index === -1 ? 20 : Number(rest[index + 1])
    if (!Number.isSafeInteger(n) || n < 1) usageError('-n must be a positive integer')
    const events = readTranscript()
    const entries = [...messages(events), ...events.filter(e => e.event === 'plan_review')]
      .sort((a, b) => (a.created_at || a.ts).localeCompare(b.created_at || b.ts)).slice(-n)
    if (!entries.length) console.log('No bridge requests yet.')
    for (const e of entries) {
      if (e.event === 'plan_review') console.log(`${e.ts}  plan review  ${e.author} → ${e.reviewer}  [${e.outcome}]\n${e.review || ''}`)
      else console.log(formatMessages([e], { verbose }))
    }
    break
  }
  default:
    usageError(`Unknown command: ${cmd}`)
}

} catch (err) { console.error(`cc-bridge: ${err.message}`); process.exitCode = 1 }
