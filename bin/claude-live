#!/bin/sh
# Claude Code with the cc-bridge channel enabled (needs the cc-bridge plugin; see
# cc-bridge install). Arguments pass through, e.g. --continue or --resume <id>.
# CC_BRIDGE_LABEL names the session (default "claude").
exec "${CC_BRIDGE_CLAUDE_BIN:-claude}" --dangerously-load-development-channels plugin:cc-bridge@cc-bridge "$@"
